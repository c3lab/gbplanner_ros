<launch>
    <!-- Everything this repo runs on the ANYmal, in one container.
         Step 2 of 3 on the robot:

           1. host      main.launch, with its gbplanner2 include commented out
           2. this      planner + per-robot TF prefixing   (make run-robot)
           3. bridge    ROS 1 <-> ROS 2                    (make run-robot-bridge)

         Split that way on purpose: after step 2 the whole TF picture is
         inspectable on the robot's own master, with no ROS 2 involved, so a
         problem there is not confused with a bridge or DDS problem.

         The two halves stay independent launch files. gbplanner.launch is a
         drop-in replacement for the gbplanner2 one and must keep working when
         launched alone; tf_prefix.launch touches no planner topic. -->

    <!-- ROS namespace for the planner's topics and services. Matches what the
         gbplanner2 stack used, so operator tooling keeps working. -->
    <arg name="robot_name" default="anymal"/>

    <!-- TF frame prefix in the fleet graph. Deliberately NOT tied to
         robot_name: every ANYmal answers on /anymal/... locally, while the
         fleet needs them distinguishable. -->
    <arg name="prefix" default="robot0"/>

    <!-- External navigation goals the planner listens on. Relative, so it
         resolves under /$(arg robot_name)/ - the same layout the sim preset
         gives, so one publisher serves both. Scene graph goals still arrive:
         gbplanner.launch relays its topic into this one. -->
    <arg name="navigation_goal_topic" default="move_base_simple/goal"/>

    <!-- Forwarded too, or they cannot be reached on the robot path: make
         run-robot goes only through this file, so an arg declared solely in
         gbplanner.launch is unreachable without editing that file. -->
    <arg name="hydra_goal_topic" default="/hydra_ros_node/navigation/navigation_goals"/>
    <arg name="hydra_goal_relay_en" default="false"/>

    <arg name="planner_en"   default="true"/>
    <arg name="tf_prefix_en" default="true"/>

    <include if="$(arg planner_en)"
             file="$(find gbplanner)/launch/anymal/gbplanner.launch">
        <arg name="robot_name" value="$(arg robot_name)"/>
        <arg name="navigation_goal_topic" value="$(arg navigation_goal_topic)"/>
        <arg name="hydra_goal_topic" value="$(arg hydra_goal_topic)"/>
        <arg name="hydra_goal_relay_en" value="$(arg hydra_goal_relay_en)"/>
    </include>

    <include if="$(arg tf_prefix_en)"
             file="$(find gbplanner)/launch/anymal/tf_prefix.launch">
        <arg name="prefix" value="$(arg prefix)"/>
    </include>
</launch>
