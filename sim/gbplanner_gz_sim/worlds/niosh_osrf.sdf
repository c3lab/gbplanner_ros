<?xml version="1.0" ?>
<!--
  NIOSH experimental mine, ported from the ROS 1 arl_gazebo_sim world
  gzc/worlds/niosh_osrf.world (BSD-3-Clause, see that repository's LICENSE).
  It is the world behind the wiki's uav_gzc_niosh_exploration and
  ugv_gzc_niosh_exploration demos.

  The tunnel model it names (model://niosh_seg01) is NOT in this package: it is
  in the ~3.9 GB git-lfs `subt_cave_sim` model set, and at 223 MB in one DAE it
  is the single largest asset any of these worlds pulls in. Point
  GZ_SIM_RESOURCE_PATH at a checkout of it, or pass resource_path:= to
  gz_sim.launch.py.

  Changes from the ROS 1 original, all forced by Gazebo Classic being end of
  life rather than chosen:

  * librotors_gazebo_ros_interface_plugin is gone. It was Classic's bridge into
    ROS 1 for the RotorS multicopter; on Harmonic that job belongs to
    ros_gz_bridge, which gz_sim.launch.py starts.
  * The Classic ODE <physics> block (quick solver, 1000 iterations, sor 1.3) is
    replaced by Harmonic's engine-agnostic form. Those knobs name ODE
    internals, and Harmonic's default engine is DART.
  * The Harmonic system plugins and a gz-gui block are added: Classic loaded
    physics, scene and sensors implicitly, gz-sim loads nothing it is not told
    to. Without the Sensors system the gpu_lidar produces no data at all.
  * <spherical_coordinates> is dropped: nothing in this stack consumes it, and
    Harmonic warns about the missing <world_frame_orientation>.
  * The world is named after the file rather than "default". Every gz service
    and topic path contains the world name, so "default" would make two
    simultaneously running scenarios indistinguishable in `gz topic -l`.
-->
<sdf version="1.9">
  <world name="niosh_osrf">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system"
        name="gz::sim::systems::Physics">
    </plugin>
    <plugin filename="gz-sim-user-commands-system"
        name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system"
        name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="gz-sim-imu-system"
        name="gz::sim::systems::Imu">
    </plugin>
    <plugin filename="gz-sim-sensors-system"
        name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.8 0.8 0.8</background_color>
        <camera_pose>-6 -20 12 0 0.35 1.2</camera_pose>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager"/>
      <plugin filename="InteractiveViewControl" name="Interactive view control"/>
      <plugin filename="CameraTracking" name="Camera Tracking"/>

      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
        <service>/world/niosh_osrf/control</service>
        <stats_topic>/world/niosh_osrf/stats</stats_topic>
      </plugin>

      <plugin filename="WorldStats" name="World stats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
        <topic>/world/niosh_osrf/stats</topic>
      </plugin>

      <plugin filename="EntityTree" name="Entity tree"/>
      <plugin filename="ComponentInspector" name="Component Inspector"/>
    </gui>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <include>
      <name>niosh_seg01</name>
      <uri>model://niosh_seg01</uri>
      <pose>-13 0 -2 0 0 -1.57</pose>
    </include>

  </world>
</sdf>
