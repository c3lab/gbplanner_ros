<?xml version="1.0" ?>
<!--
  A cave-shaped world built entirely from primitives: an 80 m gallery with three
  side chambers, pillars and scattered rock, enclosed by a floor and ceiling.

  It exists because darpa_cave_01.sdf needs the ~3.9 GB subt_cave_sim model set,
  which is not vendored anywhere in this repository. This world needs nothing on
  GZ_SIM_RESOURCE_PATH, so `ros2 launch gbplanner_gz_sim gz_sim.launch.py
  world:=cave_box` is a complete simulation on a fresh checkout, and it is what
  the package's own verification runs against.

  It is closed on all sides on purpose. Voxblox only marks a voxel free when a
  ray passes through it and terminates on a surface; an open world leaves the
  lidar's 50 m rays ending in nothing, the map stays unknown, and the planner's
  volumetric gain has no gradient to follow.

  Generated by worlds/gen_cave_box.py. Change the geometry there and re-run it;
  do not hand-edit the 36 <model> blocks below.
-->
<sdf version="1.9">
  <world name="cave_box">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.5 0.5 0.5</ambient_light>
        <background_color>0.6 0.6 0.65</background_color>
        <camera_pose>-14 -14 10 0 0.5 0.7</camera_pose>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager"/>
      <plugin filename="InteractiveViewControl" name="Interactive view control"/>
      <plugin filename="CameraTracking" name="Camera Tracking"/>
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">floating</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
        <service>/world/cave_box/control</service>
        <stats_topic>/world/cave_box/stats</stats_topic>
      </plugin>
      <plugin filename="EntityTree" name="Entity tree"/>
    </gui>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="floor">
      <static>true</static>
      <pose>0 0 -0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>81.0 40.0 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>81.0 40.0 0.5</size></box></geometry>
          <material>
            <ambient>0.35 0.33 0.30 1</ambient>
            <diffuse>0.55 0.52 0.47 1</diffuse>
          </material>
        </visual>
