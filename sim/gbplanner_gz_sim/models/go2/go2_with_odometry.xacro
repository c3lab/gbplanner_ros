<?xml version="1.0"?>
<robot name="go2" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find unitree_go2_description)/urdf/unitree_go2_robot.xacro"/>

  <gazebo>
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_topic>/model/go2/odometry</odom_topic>
      <odom_covariance_topic>/model/go2/odometry_with_covariance</odom_covariance_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <publish_tf>false</publish_tf>
      <dimensions>3</dimensions>
    </plugin>
  </gazebo>

</robot>
