<?xml version="1.0"?>
<!--
  MARBLE Husky (Clearpath Husky A200 in the MARBLE SubT sensor configuration),
  derived from gz/ugv_sim/ugv_gazebo/models/marble_husky/model.sdf in the ROS 1
  arl_gazebo_sim package, which carries that repository's BSD-3-Clause LICENSE.

  Like models/rmf_owl/model.sdf.in this is a TEMPLATE, not a loadable model:
  gz_sim.launch.py renders it per spawned robot, substituting {{robot_name}} and
  dropping the BEGIN:/END: blocks whose launch flag is false.

  Unlike the UAV, nothing had to be reimplemented. Every system this model uses
  -- DiffDrive, OdometryPublisher, PosePublisher -- ships with Harmonic, so the
  robot is driven by publishing a Twist at DiffDrive; what the UAV needed a ROS
  position loop for, the wheels do here. gbplanner_gz_control's
  ugv_path_follower_node only turns the planner's path into that Twist.

  Changes from the ROS 1 original, and why:

  * The 5.3 MB of DAE visuals are replaced by primitives that trace the
    collision boxes already in the original. Masses, inertias and wheel geometry
    are copied verbatim, and the lidar raycasts the render scene from above the
    chassis either way. Same trade the rmf_owl template makes, for the same
    reason: the meshes are binary assets that would have to be vendored.
  * The wheels' friction is isotropic mu = mu2 = 1.0 where the original had
    mu 0.2 / mu2 10.5 along <fdir1>. That pair is an ODE skid-steer trick --
    cheap rolling, expensive scrub -- and Harmonic's default engine is DART,
    which does not honour fdir1 the way ODE does. Carried over literally it
    reads as a 0.2 coefficient in every direction, and 46 kg on four driven
    wheels then spins them instead of moving.
  * The lidar moved from a sensor on base_link into its own laser_link on a
    fixed joint. gz reports a point cloud in the sensor's own frame, so a
    <gz_frame_id> of base_link -- which is what the original's frame naming
    amounts to once bridged -- would have placed every cloud 0.42 m behind and
    0.39 m below the truth. The link carries 0.1 kg against the chassis's 46 kg.
  * The lidar's vertical fan is widened and its minimum range shortened; the
    comments at the sensor say why. Neither is what unblocked the planner on
    this robot - that was RobotParams.center_offset in the UGV configs - but a
    single thin horizontal fan 0.57 m off the ground maps almost none of the
    floor within 2 m, and the planner configs were written for a robot that
    also carried a lidar tilted at it.
  * PosePublisher publishes only link and model poses, on the dynamic topic.
    The original also asked for visual, collision and sensor poses and used
    static_publisher; tf2's static listener subscribes transient_local while
    ros_gz_bridge publishes volatile, so a bridged /tf_static never arrives.
  * The JointController blocks were commented out in the original (DiffDrive
    already drives all four joints) and are dropped rather than carried over
    commented.
  * <use_parent_model_frame> is gone from the wheel joints: it was removed in
    SDFormat 1.7, and the axis is already expressed in the joint's parent frame
    without it.
-->
<sdf version="1.9">
    <model name="{{robot_name}}" canonical_link="base_link">

        <link name="base_link">
            <pose>0 0 0 0 -0 0</pose>
            <inertial>
                <pose>-0.000543 -0.084945 0.062329 0 -0 0</pose>
                <mass>46.064</mass>
                <inertia>
                    <ixx>0.615397</ixx>
                    <ixy>-0.0240585</ixy>
                    <ixz>-0.120749</ixz>
                    <iyy>1.75388</iyy>
                    <iyz>-0.0028322</iyz>
                    <izz>2.03641</izz>
                </inertia>
            </inertial>

            <collision name="base_link_collision">
                <pose>0 0 0.12 0 0 0</pose>
                <geometry>
                    <box>
                        <size>0.9874 0.5709 0.05</size>
                    </box>
                </geometry>
            </collision>
            <collision name="base_link_collision_bottom">
                <pose>0 0 0.046 0 0 0</pose>
                <geometry>
                    <box>
                        <size>0.80 0.5709 0.095</size>
                    </box>
                </geometry>
            </collision>
            <collision name="base_link_collision_1">
                <pose>0 0 0.185625 0 -0 0</pose>
                <geometry>
                    <box>
                        <size>0.78992 0.5709 0.12375</size>
                    </box>
                </geometry>
            </collision>
            <collision name="sensor_tower_collision">
                <pose>0.374 0 0.215 0 -0 0</pose>
                <geometry>
                    <box>
                        <size>0.2 0.25 0.225</size>
                    </box>
                </geometry>
            </collision>
            <collision name="computer_block_collision">
                <pose>0.050 0 0.185 0 -0 0</pose>
                <geometry>
                    <box>
                        <size>0.300 0.355 0.175</size>
                    </box>
                </geometry>
            </collision>

            <visual name="chassis_visual">
                <pose>0 0 0.12 0 0 0</pose>
                <geometry>
                    <box>
                        <size>0.9874 0.5709 0.16</size>
                    </box>
                </geometry>
                <material>
                    <ambient>0.25 0.20 0.05 1</ambient>
                    <diffuse>0.85 0.65 0.05 1</diffuse>
                </material>
            </visual>
            <visual name="top_plate_visual">
                <pose>0 0 0.19 0 -0 0</pose>
                <geometry>
                    <box>
                        <size>0.78992 0.5709 0.12375</size>
                    </box>
                </geometry>
                <material>
                    <ambient>0.05 0.05 0.05 1</ambient>
                    <diffuse>0.15 0.15 0.15 1</diffuse>
                </material>
            </visual>
            <visual name="front_bumper_visual">
                <pose>0.48 0 0.091 0 -0 0</pose>
                <geometry>
                    <box>
                        <size>0.04 0.5709 0.06</size>
                    </box>
                </geometry>
                <material>
                    <ambient>0.05 0.05 0.05 1</ambient>
                    <diffuse>0.12 0.12 0.12 1</diffuse>
                </material>
            </visual>
            <visual name="rear_bumper_visual">
                <pose>-0.48 0 0.091 0 -0 0</pose>
                <geometry>
                    <box>
                        <size>0.04 0.5709 0.06</size>
                    </box>
                </geometry>
                <material>
                    <ambient>0.05 0.05 0.05 1</ambient>
                    <diffuse>0.12 0.12 0.12 1</diffuse>
                </material>
            </visual>
            <visual name="sensor_tower_visual">
                <pose>0.374 0 0.215 0 -0 0</pose>
                <geometry>
                    <box>
                        <size>0.2 0.25 0.225</size>
                    </box>
                </geometry>
                <material>
                    <ambient>0.10 0.10 0.10 1</ambient>
                    <diffuse>0.25 0.25 0.25 1</diffuse>
                </material>
            </visual>
            <visual name="computer_block_visual">
                <pose>0.050 0 0.185 0 -0 0</pose>
                <geometry>
                    <box>
                        <size>0.29 0.415 0.078</size>
                    </box>
                </geometry>
                <material>
                    <ambient>0.10 0.10 0.12 1</ambient>
                    <diffuse>0.30 0.30 0.35 1</diffuse>
                </material>
            </visual>

            <sensor name="imu_sensor" type="imu">
                <always_on>1</always_on>
                <update_rate>200</update_rate>
                <visualize>false</visualize>
                <topic>{{robot_name}}/imu</topic>
                <gz_frame_id>{{robot_name}}/base_link</gz_frame_id>
                <imu>
                    <enable_orientation>0</enable_orientation>
                    <angular_velocity>
                        <x>
                            <noise type="gaussian">
                                <mean>0</mean>
                                <stddev>0.009</stddev>
                                <bias_mean>0.00075</bias_mean>
                                <bias_stddev>0.005</bias_stddev>
                            </noise>
                        </x>
                        <y>
                            <noise type="gaussian">
                                <mean>0</mean>
                                <stddev>0.009</stddev>
                                <bias_mean>0.00075</bias_mean>
                                <bias_stddev>0.005</bias_stddev>
                            </noise>
                        </y>
                        <z>
                            <noise type="gaussian">
                                <mean>0</mean>
                                <stddev>0.009</stddev>
                                <bias_mean>0.00075</bias_mean>
                                <bias_stddev>0.005</bias_stddev>
                            </noise>
                        </z>
                    </angular_velocity>
                    <linear_acceleration>
                        <x>
                            <noise type="gaussian">
                                <mean>0</mean>
                                <stddev>0.021</stddev>
                                <bias_mean>0.05</bias_mean>
                                <bias_stddev>0.0075</bias_stddev>
                            </noise>
                        </x>
                        <y>
                            <noise type="gaussian">
                                <mean>0</mean>
                                <stddev>0.021</stddev>
                                <bias_mean>0.05</bias_mean>
                                <bias_stddev>0.0075</bias_stddev>
                            </noise>
                        </y>
                        <z>
                            <noise type="gaussian">
                                <mean>0</mean>
                                <stddev>0.021</stddev>
                                <bias_mean>0.05</bias_mean>
                                <bias_stddev>0.0075</bias_stddev>
                            </noise>
                        </z>
                    </linear_acceleration>
                </imu>
            </sensor>

            <!--BEGIN:camera-->
            <sensor name="camera_front" type="rgbd_camera">
                <pose>0.468 0 0.360 0 -0 0</pose>
                <topic>{{robot_name}}/camera_front</topic>
                <gz_frame_id>{{robot_name}}/base_link</gz_frame_id>
                <always_on>1</always_on>
                <update_rate>30</update_rate>
                <visualize>false</visualize>
                <camera name="camera_front">
                    <horizontal_fov>1.5184</horizontal_fov>
                    <image>
                        <width>320</width>
                        <height>240</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip>
                        <near>0.01</near>
                        <far>300</far>
                    </clip>
                    <depth_camera>
                        <clip>
                            <near>0.1</near>
                            <far>10</far>
                        </clip>
                    </depth_camera>
                    <noise>
                        <type>gaussian</type>
                        <mean>0</mean>
                        <stddev>0.007</stddev>
                    </noise>
                </camera>
            </sensor>
            <!--END:camera-->
        </link>

        <!--
          The lidar's own link. Its pose is the sensor pose the original gave
          inside base_link, so the beams start where they always did.
        -->
        <link name="laser_link">
            <pose>0.424 0 0.400 0 -0 0</pose>
            <inertial>
                <pose>0 0 0.0359 0 -0 0</pose>
                <mass>0.1</mass>
                <inertia>
                    <ixx>9.2e-05</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>9.2e-05</iyy>
                    <iyz>0</iyz>
                    <izz>9.5e-05</izz>
                </inertia>
            </inertial>
            <collision name="laser_collision">
                <pose>0 0 0.0359 0 -0 0</pose>
                <geometry>
                    <cylinder>
                        <length>0.0717</length>
                        <radius>0.0516</radius>
                    </cylinder>
                </geometry>
            </collision>
            <visual name="laser_visual">
                <pose>0 0 0.0359 0 -0 0</pose>
                <geometry>
                    <cylinder>
                        <length>0.0717</length>
                        <radius>0.0516</radius>
                    </cylinder>
                </geometry>
                <material>
                    <ambient>0.6 0.6 0.62 1</ambient>
                    <diffuse>0.75 0.75 0.78 1</diffuse>
                </material>
            </visual>
            <!--BEGIN:lidar-->
            <sensor name="laser" type="gpu_lidar">
                <pose>0 0 0.0359 0 -0 0</pose>
                <topic>{{robot_name}}/lidar</topic>
                <gz_frame_id>{{robot_name}}/laser_link</gz_frame_id>
                <update_rate>10</update_rate>
                <visualize>false</visualize>
                <always_on>1</always_on>
                <lidar>
                    <scan>
                        <horizontal>
                            <samples>{{lidar_horizontal_samples}}</samples>
                            <resolution>1</resolution>
                            <min_angle>-3.14159</min_angle>
                            <max_angle>3.14159</max_angle>
                        </horizontal>
                        <vertical>
                            <!--
                              +/- 45 degrees, an OS0 fan, where the ROS 1 model
                              quoted the OS1's +/- 16.6. The ROS 1 UGV was the
                              SMB, and it carried two lidars into gbplanner: a
                              horizontal VLP-16 and an OS1-64 pitched 0.5 rad
                              down, relayed onto one input cloud. The planner
                              configs assume that ground coverage. A single
                              horizontal +/- 16.6 fan mounted 0.57 m up sees no
                              floor at all inside 1.9 m and only a thin band
                              beyond it, so voxblox never marks the slab the
                              robot has to drive through as free. Widening the
                              one lidar is the cheaper half of modelling the
                              SMB's two; it is not on its own what lets the
                              planner build a graph here, see the center_offset
                              comment in the UGV configs for that.
                            -->
                            <samples>{{lidar_vertical_samples}}</samples>
                            <resolution>1</resolution>
                            <min_angle>-0.785398</min_angle>
                            <max_angle>0.785398</max_angle>
                        </vertical>
                    </scan>
                    <range>
                        <!--
                          0.3 m, not the OS1-128 datasheet's 0.8 m the ROS 1
                          model quoted. voxblox only calls a voxel free when a
                          ray passes through it, so an 0.8 m blind sphere leaves
                          a shell of unknown voxels wrapped around the robot
                          that the planner's own augmentFreeBox does not reach.
                          The ROS 1 UGV carried a VLP-16, whose minimum is
                          0.4 m, and 0.3 m is what the RMF-Owl's lidar uses in
                          this package.
                        -->
                        <min>0.3</min>
                        <max>120</max>
                        <resolution>0.01</resolution>
                    </range>
                    <noise>
                        <type>gaussian</type>
                        <mean>0</mean>
                        <stddev>0.01</stddev>
                    </noise>
                </lidar>
            </sensor>
            <!--END:lidar-->
        </link>
        <joint name="laser_joint" type="fixed">
            <child>laser_link</child>
            <parent>base_link</parent>
        </joint>

        <link name="front_left_wheel_link">
            <pose>0.256 0.2854 0.03282 0 -0 0</pose>
            <inertial>
                <pose>0 0 0 0 -0 0</pose>
                <mass>2.637</mass>
                <inertia>
                    <ixx>0.02467</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.04411</iyy>
                    <iyz>0</iyz>
                    <izz>0.02467</izz>
                </inertia>
            </inertial>
            <collision name="front_left_wheel_link_collision">
                <pose>0 0 0 1.5707963267948966 -0 0</pose>
                <geometry>
                    <cylinder>
                        <length>0.1143</length>
                        <radius>0.1651</radius>
                    </cylinder>
                </geometry>
                <surface>
                    <contact>
                        <ode>
                            <kp>1e+07</kp>
                            <kd>1</kd>
                        </ode>
                    </contact>
                    <friction>
                        <ode>
                            <mu>1.0</mu>
                            <mu2>1.0</mu2>
                        </ode>
                    </friction>
                </surface>
            </collision>
            <visual name="front_left_wheel_link_visual">
                <pose>0 0 0 1.5707963267948966 -0 0</pose>
                <geometry>
                    <cylinder>
                        <length>0.1143</length>
                        <radius>0.1651</radius>
                    </cylinder>
                </geometry>
                <material>
                    <ambient>0.03 0.03 0.03 1</ambient>
                    <diffuse>0.08 0.08 0.08 1</diffuse>
                </material>
            </visual>
        </link>
        <joint name="front_left_wheel_joint" type="revolute">
            <child>front_left_wheel_link</child>
            <parent>base_link</parent>
            <axis>
                <xyz>0 1 0</xyz>
                <limit>
                    <lower>-1e+16</lower>
                    <upper>1e+16</upper>
                </limit>
                <dynamics>
                    <spring_reference>0</spring_reference>
                    <spring_stiffness>0</spring_stiffness>
                </dynamics>
            </axis>
        </joint>

        <link name="front_right_wheel_link">
            <pose>0.256 -0.2854 0.03282 0 -0 0</pose>
            <inertial>
                <pose>0 0 0 0 -0 0</pose>
                <mass>2.637</mass>
                <inertia>
                    <ixx>0.02467</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.04411</iyy>
                    <iyz>0</iyz>
                    <izz>0.02467</izz>
                </inertia>
            </inertial>
            <collision name="front_right_wheel_link_collision">
                <pose>0 0 0 1.5707963267948966 -0 0</pose>
                <geometry>
                    <cylinder>
                        <length>0.1143</length>
                        <radius>0.1651</radius>
                    </cylinder>
                </geometry>
                <surface>
                    <contact>
                        <ode>
                            <kp>1e+07</kp>
                            <kd>1</kd>
                        </ode>
                    </contact>
                    <friction>
                        <ode>
                            <mu>1.0</mu>
                            <mu2>1.0</mu2>
                        </ode>
                    </friction>
                </surface>
            </collision>
            <visual name="front_right_wheel_link_visual">
                <pose>0 0 0 1.5707963267948966 -0 0</pose>
                <geometry>
                    <cylinder>
                        <length>0.1143</length>
                        <radius>0.1651</radius>
                    </cylinder>
                </geometry>
                <material>
                    <ambient>0.03 0.03 0.03 1</ambient>
                    <diffuse>0.08 0.08 0.08 1</diffuse>
                </material>
            </visual>
        </link>
        <joint name="front_right_wheel_joint" type="revolute">
            <child>front_right_wheel_link</child>
            <parent>base_link</parent>
            <axis>
                <xyz>0 1 0</xyz>
                <limit>
                    <lower>-1e+16</lower>
                    <upper>1e+16</upper>
                </limit>
                <dynamics>
                    <spring_reference>0</spring_reference>
                    <spring_stiffness>0</spring_stiffness>
                </dynamics>
            </axis>
        </joint>

        <link name="rear_left_wheel_link">
            <pose>-0.256 0.2854 0.03282 0 -0 0</pose>
            <inertial>
                <pose>0 0 0 0 -0 0</pose>
                <mass>2.637</mass>
                <inertia>
                    <ixx>0.02467</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.04411</iyy>
                    <iyz>0</iyz>
                    <izz>0.02467</izz>
                </inertia>
            </inertial>
            <collision name="rear_left_wheel_link_collision">
                <pose>0 0 0 1.5707963267948966 -0 0</pose>
                <geometry>
                    <cylinder>
                        <length>0.1143</length>
                        <radius>0.1651</radius>
                    </cylinder>
                </geometry>
                <surface>
                    <contact>
                        <ode>
                            <kp>1e+07</kp>
                            <kd>1</kd>
                        </ode>
                    </contact>
                    <friction>
                        <ode>
                            <mu>1.0</mu>
                            <mu2>1.0</mu2>
                        </ode>
                    </friction>
                </surface>
            </collision>
            <visual name="rear_left_wheel_link_visual">
                <pose>0 0 0 1.5707963267948966 -0 0</pose>
                <geometry>
                    <cylinder>
                        <length>0.1143</length>
                        <radius>0.1651</radius>
                    </cylinder>
                </geometry>
                <material>
                    <ambient>0.03 0.03 0.03 1</ambient>
                    <diffuse>0.08 0.08 0.08 1</diffuse>
                </material>
            </visual>
        </link>
        <joint name="rear_left_wheel_joint" type="revolute">
            <child>rear_left_wheel_link</child>
            <parent>base_link</parent>
            <axis>
                <xyz>0 1 0</xyz>
                <limit>
                    <lower>-1e+16</lower>
                    <upper>1e+16</upper>
                </limit>
                <dynamics>
                    <spring_reference>0</spring_reference>
                    <spring_stiffness>0</spring_stiffness>
                </dynamics>
            </axis>
        </joint>

        <link name="rear_right_wheel_link">
            <pose>-0.256 -0.2854 0.03282 0 -0 0</pose>
            <inertial>
                <pose>0 0 0 0 -0 0</pose>
                <mass>2.637</mass>
                <inertia>
                    <ixx>0.02467</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.04411</iyy>
                    <iyz>0</iyz>
                    <izz>0.02467</izz>
                </inertia>
            </inertial>
            <collision name="rear_right_wheel_link_collision">
                <pose>0 0 0 1.5707963267948966 -0 0</pose>
                <geometry>
                    <cylinder>
                        <length>0.1143</length>
                        <radius>0.1651</radius>
                    </cylinder>
                </geometry>
                <surface>
                    <contact>
                        <ode>
                            <kp>1e+07</kp>
                            <kd>1</kd>
                        </ode>
                    </contact>
                    <friction>
                        <ode>
                            <mu>1.0</mu>
                            <mu2>1.0</mu2>
                        </ode>
                    </friction>
                </surface>
            </collision>
            <visual name="rear_right_wheel_link_visual">
                <pose>0 0 0 1.5707963267948966 -0 0</pose>
                <geometry>
                    <cylinder>
                        <length>0.1143</length>
                        <radius>0.1651</radius>
                    </cylinder>
                </geometry>
                <material>
                    <ambient>0.03 0.03 0.03 1</ambient>
                    <diffuse>0.08 0.08 0.08 1</diffuse>
                </material>
            </visual>
        </link>
        <joint name="rear_right_wheel_joint" type="revolute">
            <child>rear_right_wheel_link</child>
            <parent>base_link</parent>
            <axis>
                <xyz>0 1 0</xyz>
                <limit>
                    <lower>-1e+16</lower>
                    <upper>1e+16</upper>
                </limit>
                <dynamics>
                    <spring_reference>0</spring_reference>
                    <spring_stiffness>0</spring_stiffness>
                </dynamics>
            </axis>
        </joint>

        <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
            <left_joint>rear_left_wheel_joint</left_joint>
            <left_joint>front_left_wheel_joint</left_joint>
            <right_joint>rear_right_wheel_joint</right_joint>
            <right_joint>front_right_wheel_joint</right_joint>
            <wheel_separation>0.5708</wheel_separation>
            <wheel_radius>0.1651</wheel_radius>
            <topic>{{robot_name}}/command/velocity</topic>
            <max_linear_velocity>2.0</max_linear_velocity>
            <max_angular_velocity>1</max_angular_velocity>
            <max_linear_acceleration>3</max_linear_acceleration>
            <max_angular_acceleration>2</max_angular_acceleration>
        </plugin>

        <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
            <odom_frame>world</odom_frame>
            <robot_base_frame>{{robot_name}}/base_link</robot_base_frame>
            <odom_publish_frequency>50</odom_publish_frequency>
            <odom_topic>{{robot_name}}/odometry</odom_topic>
            <odom_covariance_topic>{{robot_name}}/odometry_with_covariance</odom_covariance_topic>
            <dimensions>3</dimensions>
        </plugin>

        <plugin filename="gz-sim-pose-publisher-system"
            name="gz::sim::systems::PosePublisher">
            <publish_link_pose>true</publish_link_pose>
            <publish_visual_pose>false</publish_visual_pose>
            <publish_collision_pose>false</publish_collision_pose>
            <publish_sensor_pose>false</publish_sensor_pose>
            <publish_model_pose>true</publish_model_pose>
            <publish_nested_model_pose>false</publish_nested_model_pose>
            <use_pose_vector_msg>true</use_pose_vector_msg>
            <static_publisher>false</static_publisher>
            <update_frequency>50</update_frequency>
        </plugin>
    </model>
</sdf>
