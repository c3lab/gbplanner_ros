<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gbplanner_gz_sim</name>
  <version>3.0.0</version>
  <description>
    Gazebo Harmonic worlds, robot models, bridge and launch files that feed the
    gbplanner ROS 2 stack with odometry, a lidar point cloud, TF and /clock.
  </description>
  <maintainer email="sant.gabriele02@gmail.com">gbplanner3 maintainers</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>gbplanner_gz_control</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
