# Tier C - third-party packages that DEPEND on gbplanner's own packages
# (planner_common / map_manager / planner_msgs). They are cloned into bootstrap/
# and bind-mounted, never baked, so editing a .srv does not force an image rebuild.
#
# https: the repositories are public under c3lab, so cloning needs no
# credentials. Branch `jazzy` is the ROS 2 port; each repository's default
# branch is still the ROS 1 original.
repositories:
  exploration/adaptive_obb_ros2:
    type: git
    url: https://github.com/c3lab/adaptive_obb_ros.git
    version: jazzy
  exploration/pci_general_ros2:
    type: git
    url: https://github.com/c3lab/pci_general.git
    version: jazzy
  exploration/manhole_detector_ros2:
    type: git
    url: https://github.com/c3lab/manhole_detector_ros.git
    version: jazzy
