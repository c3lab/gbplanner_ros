ARG ROS_DISTRO=jazzy
FROM ros:${ROS_DISTRO}

SHELL ["/bin/bash", "-c"]
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC
ARG ROS_DISTRO

# ---------------------------------------------------------------------------
# System libraries
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    curl \
    git \
    git-lfs \
    gnupg \
    lsb-release \
    pkg-config \
    ssh-client \
    libboost-all-dev \
    libeigen3-dev \
    libgflags-dev \
    libgoogle-glog-dev \
    libopencv-dev \
    libpcl-dev \
    libprotobuf-dev \
    protobuf-compiler \
    qtbase5-dev \
    libqt5opengl5-dev \
    libdw-dev \
    libelf-dev \
    liboctomap-dev \
    python3-colcon-common-extensions \
    python3-vcstool \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# ROS 2 packages
#
# Every name here was verified to exist as a Jazzy binary in a throwaway
# ros:jazzy container (see docs/apt-groundtruth-jazzy.txt). Gazebo comes in via
# ros-gz-sim, which depends on the ros-jazzy-gz-*-vendor packages (Harmonic,
# gz-sim8) - Jazzy's official pairing. We deliberately do NOT add the OSRF
# gazebo apt repo: mixing the vendored gz with a system gz-harmonic gives two
# copies of gz-transport, which is not ABI compatible across major versions.
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-ament-cmake \
    ros-${ROS_DISTRO}-ament-cmake-gtest \
    ros-${ROS_DISTRO}-ament-index-cpp \
    ros-${ROS_DISTRO}-ament-lint-auto \
    ros-${ROS_DISTRO}-rclcpp \
    ros-${ROS_DISTRO}-rclcpp-action \
    ros-${ROS_DISTRO}-rclcpp-components \
    ros-${ROS_DISTRO}-rosidl-default-generators \
    ros-${ROS_DISTRO}-rosidl-default-runtime \
    ros-${ROS_DISTRO}-eigen3-cmake-module \
    ros-${ROS_DISTRO}-pluginlib \
    ros-${ROS_DISTRO}-message-filters \
    ros-${ROS_DISTRO}-backward-ros \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-tf2 \
    ros-${ROS_DISTRO}-tf2-ros \
    ros-${ROS_DISTRO}-tf2-eigen \
    ros-${ROS_DISTRO}-tf2-geometry-msgs \
    ros-${ROS_DISTRO}-tf2-sensor-msgs \
    ros-${ROS_DISTRO}-geometry-msgs \
    ros-${ROS_DISTRO}-nav-msgs \
    ros-${ROS_DISTRO}-sensor-msgs \
    ros-${ROS_DISTRO}-std-srvs \
    ros-${ROS_DISTRO}-trajectory-msgs \
    ros-${ROS_DISTRO}-visualization-msgs \
    ros-${ROS_DISTRO}-octomap-msgs \
    ros-${ROS_DISTRO}-cv-bridge \
    ros-${ROS_DISTRO}-image-transport \
    ros-${ROS_DISTRO}-interactive-markers \
    ros-${ROS_DISTRO}-pcl-conversions \
    ros-${ROS_DISTRO}-pcl-ros \
    && rm -rf /var/lib/apt/lists/*

# grid_map: gbplanner links grid_map_core/ros/msgs/filters (gbplanner/package.xml:24-27)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-grid-map-core \
    ros-${ROS_DISTRO}-grid-map-ros \
    ros-${ROS_DISTRO}-grid-map-msgs \
    ros-${ROS_DISTRO}-grid-map-filters \
    ros-${ROS_DISTRO}-grid-map-cv \
    && rm -rf /var/lib/apt/lists/*

# BehaviorTree.CPP: the ROS 1 side vendored 4.7.0 from source; Jazzy ships 4.9.0
# binaries. Same v4 API family, stricter XML validation - see docs/BT_NOTES.md.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-behaviortree-cpp \
    && rm -rf /var/lib/apt/lists/*

# Visualisation + simulation + bag tooling
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-rviz2 \
    ros-${ROS_DISTRO}-rviz-common \
    ros-${ROS_DISTRO}-rviz-rendering \
    ros-${ROS_DISTRO}-rviz-default-plugins \
    ros-${ROS_DISTRO}-rviz-ogre-vendor \
    ros-${ROS_DISTRO}-ros-gz-sim \
    ros-${ROS_DISTRO}-ros-gz-bridge \
    ros-${ROS_DISTRO}-ros-gz-image \
    ros-${ROS_DISTRO}-ros-gz-interfaces \
    ros-${ROS_DISTRO}-xacro \
    ros-${ROS_DISTRO}-robot-state-publisher \
    ros-${ROS_DISTRO}-joint-state-publisher \
    ros-${ROS_DISTRO}-rosbag2 \
    ros-${ROS_DISTRO}-ros2bag \
    ros-${ROS_DISTRO}-rosbag2-storage-mcap \
    ros-${ROS_DISTRO}-launch-testing \
    ros-${ROS_DISTRO}-launch-testing-ament-cmake \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Tier A - third-party sources baked into the image at /opt/deps_ws
#
# These have zero first-party dependencies, so they only change when a pin in
# vcstool/image_deps.repos moves - i.e. on an explicit image rebuild. Everything
# that depends on gbplanner's own packages stays OUT of the image (Tier C,
# bootstrap/) so a .srv edit does not force a rebuild.
# ---------------------------------------------------------------------------
COPY vcstool/image_deps.repos /tmp/image_deps.repos
RUN mkdir -p /opt/deps_ws/src \
    && vcs import /opt/deps_ws/src < /tmp/image_deps.repos \
    && source /opt/ros/${ROS_DISTRO}/setup.bash \
    && cd /opt/deps_ws \
    && colcon build \
         --merge-install \
         --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -Wno-dev \
    && rm -rf /opt/deps_ws/build /opt/deps_ws/log /tmp/image_deps.repos

# Bootstrap/dev containers are --rm (ephemeral): known_hosts never persists, so
# every fresh container re-triggers the interactive host-key prompt on the first
# git clone over SSH. accept-new auto-trusts unseen hosts but still rejects a
# host key that changed from one already accepted, unlike StrictHostKeyChecking=no.
RUN git config --global core.sshCommand "ssh -o StrictHostKeyChecking=accept-new"

WORKDIR /workspace

RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> /root/.bashrc \
    && echo "source /opt/deps_ws/install/setup.bash" >> /root/.bashrc \
    && echo "[ -f /workspace/gbplanner3_ws/install/setup.bash ] && source /workspace/gbplanner3_ws/install/setup.bash" >> /root/.bashrc

CMD ["bash"]
