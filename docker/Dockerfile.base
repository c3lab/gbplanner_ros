ARG ROS_DISTRO=jazzy
FROM ros:${ROS_DISTRO}

SHELL ["/bin/bash", "-c"]
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC
ARG ROS_DISTRO

# ---------------------------------------------------------------------------
# System libraries
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    curl \
    git \
    git-lfs \
    gnupg \
    lsb-release \
    pkg-config \
    ssh-client \
    libboost-all-dev \
    libeigen3-dev \
    libgflags-dev \
    libgoogle-glog-dev \
    libopencv-dev \
    libpcl-dev \
    libprotobuf-dev \
    protobuf-compiler \
    qtbase5-dev \
    libqt5opengl5-dev \
    libdw-dev \
    libelf-dev \
    liboctomap-dev \
    python3-colcon-common-extensions \
    python3-vcstool \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# ROS 2 packages
#
# Every name here was verified to exist as a Jazzy binary in a throwaway
# ros:jazzy container (see docs/apt-groundtruth-jazzy.txt). Gazebo comes in via
# ros-gz-sim, which depends on the ros-jazzy-gz-*-vendor packages (Harmonic,
# gz-sim8) - Jazzy's official pairing. We deliberately do NOT add the OSRF
# gazebo apt repo: mixing the vendored gz with a system gz-harmonic gives two
# copies of gz-transport, which is not ABI compatible across major versions.
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-ament-cmake \
    ros-${ROS_DISTRO}-ament-cmake-gtest \
    ros-${ROS_DISTRO}-ament-index-cpp \
    ros-${ROS_DISTRO}-ament-lint-auto \
    ros-${ROS_DISTRO}-rclcpp \
    ros-${ROS_DISTRO}-rclcpp-action \
    ros-${ROS_DISTRO}-rclcpp-components \
    ros-${ROS_DISTRO}-rosidl-default-generators \
    ros-${ROS_DISTRO}-rosidl-default-runtime \
    ros-${ROS_DISTRO}-eigen3-cmake-module \
    ros-${ROS_DISTRO}-pluginlib \
    ros-${ROS_DISTRO}-message-filters \
    ros-${ROS_DISTRO}-backward-ros \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-tf2 \
    ros-${ROS_DISTRO}-tf2-ros \
    ros-${ROS_DISTRO}-tf2-eigen \
    ros-${ROS_DISTRO}-tf2-geometry-msgs \
    ros-${ROS_DISTRO}-tf2-sensor-msgs \
    ros-${ROS_DISTRO}-geometry-msgs \
    ros-${ROS_DISTRO}-nav-msgs \
    ros-${ROS_DISTRO}-sensor-msgs \
    ros-${ROS_DISTRO}-std-srvs \
    ros-${ROS_DISTRO}-trajectory-msgs \
    ros-${ROS_DISTRO}-visualization-msgs \
    ros-${ROS_DISTRO}-octomap-msgs \
    ros-${ROS_DISTRO}-cv-bridge \
    ros-${ROS_DISTRO}-image-transport \
    ros-${ROS_DISTRO}-interactive-markers \
    ros-${ROS_DISTRO}-pcl-conversions \
    ros-${ROS_DISTRO}-pcl-ros \
    && rm -rf /var/lib/apt/lists/*

# grid_map: gbplanner links grid_map_core/ros/msgs/filters (gbplanner/package.xml:24-27)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-grid-map-core \
    ros-${ROS_DISTRO}-grid-map-ros \
    ros-${ROS_DISTRO}-grid-map-msgs \
    ros-${ROS_DISTRO}-grid-map-filters \
    ros-${ROS_DISTRO}-grid-map-cv \
    && rm -rf /var/lib/apt/lists/*

# ros2_control, and gz_ros2_control with it. Needed by quadruped_ros2_control:
# the quadruped's joints are driven through a controller_manager, its gz side is
# a gz_ros2_control plugin, and the walking controller is a
# controller_interface plugin. ros2controlcli comes too, because "which
# controllers are loaded" is the first question when a legged robot lies down
# instead of standing up.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-ros2-control \
    ros-${ROS_DISTRO}-ros2-controllers \
    ros-${ROS_DISTRO}-ros2controlcli \
    ros-${ROS_DISTRO}-gz-ros2-control \
    ros-${ROS_DISTRO}-angles \
    ros-${ROS_DISTRO}-xacro \
    && rm -rf /var/lib/apt/lists/*

# What the Go2's CHAMP stack needs on top of ros2_control: robot_localization
# for its EKF, and the velodyne description for the VLP-16 the robot carries.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-robot-localization \
    ros-${ROS_DISTRO}-velodyne \
    ros-${ROS_DISTRO}-velodyne-description \
    && rm -rf /var/lib/apt/lists/*

# BehaviorTree.CPP: the ROS 1 side vendored 4.7.0 from source; Jazzy ships 4.9.0
# binaries. Same v4 API family, stricter XML validation - see docs/BT_NOTES.md.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-behaviortree-cpp \
    && rm -rf /var/lib/apt/lists/*

# Visualisation + simulation + bag tooling
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-rviz2 \
    ros-${ROS_DISTRO}-rviz-common \
    ros-${ROS_DISTRO}-rviz-rendering \
    ros-${ROS_DISTRO}-rviz-default-plugins \
    ros-${ROS_DISTRO}-rviz-ogre-vendor \
    ros-${ROS_DISTRO}-ros-gz-sim \
    ros-${ROS_DISTRO}-ros-gz-bridge \
    ros-${ROS_DISTRO}-ros-gz-image \
    ros-${ROS_DISTRO}-ros-gz-interfaces \
    ros-${ROS_DISTRO}-xacro \
    ros-${ROS_DISTRO}-robot-state-publisher \
    ros-${ROS_DISTRO}-joint-state-publisher \
    ros-${ROS_DISTRO}-rosbag2 \
    ros-${ROS_DISTRO}-ros2bag \
    ros-${ROS_DISTRO}-rosbag2-storage-mcap \
    ros-${ROS_DISTRO}-launch-testing \
    ros-${ROS_DISTRO}-launch-testing-ament-cmake \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Tier A - third-party sources baked into the image at /opt/deps_ws
#
# These have zero first-party dependencies, so they only change when a pin in
# vcstool/image_deps.repos moves - i.e. on an explicit image rebuild. Everything
# that depends on gbplanner's own packages stays OUT of the image (Tier C,
# bootstrap/) so a .srv edit does not force a rebuild.
# ---------------------------------------------------------------------------
COPY vcstool/image_deps.repos /tmp/image_deps.repos
# --mount=type=ssh: the sources are private, and this is how they are cloned
# without a key ever reaching a layer - BuildKit exposes the host's agent as a
# socket for the duration of this RUN only. `docker compose build` forwards it
# because the base service declares `ssh: [default]`.
RUN --mount=type=ssh mkdir -p /opt/deps_ws/src \
    && mkdir -p -m 0700 ~/.ssh && ssh-keyscan -t rsa,ecdsa,ed25519 github.com >> ~/.ssh/known_hosts 2>/dev/null \
    && vcs import /opt/deps_ws/src < /tmp/image_deps.repos \
    # mav_comm's ros2 branch ships five packages and only some were actually
    # ported: mav_state_machine_msgs and mav_system_msgs call
    # rosidl_generate_interfaces without find_package(rosidl_default_generators),
    # so CMake reports "Unknown CMake command". The mav_comm metapackage in turn
    # find_package()s all four, so skipping the two broken ones is not enough -
    # it has to go too. It is a pure metapackage and installs nothing.
    # Only pci_general uses this repo, and only for mav_msgs, which builds clean.
    && touch /opt/deps_ws/src/mav_comm/mav_state_machine_msgs/COLCON_IGNORE \
             /opt/deps_ws/src/mav_comm/mav_system_msgs/COLCON_IGNORE \
             /opt/deps_ws/src/mav_comm/mav_comm/COLCON_IGNORE \
    # The Go2 checkout ships its author's build/, install/ and log/ trees, and
    # the five packages appear again under install/ with their package.xml.
    # Without this colcon finds ten packages where there are five.
    && rm -rf /opt/deps_ws/src/unitree_go2/build \
              /opt/deps_ws/src/unitree_go2/install \
              /opt/deps_ws/src/unitree_go2/log \
    && source /opt/ros/${ROS_DISTRO}/setup.bash \
    && cd /opt/deps_ws \
    # BUILD_SHARED_LIBS=ON is not optional. voxblox's CMake uses
    # ament_auto_add_library with no explicit type, so it follows this variable,
    # which CMake defaults to OFF. Static archives here mean two things: a
    # downstream shared library fails with "relocation R_X86_64_PC32 ... recompile
    # with -fPIC", and an executable in another package gets hundreds of undefined
    # references because the archives' transitive dependencies are not propagated.
    && colcon build \
         --merge-install \
         --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
                      -DBUILD_SHARED_LIBS=ON -Wno-dev \
    && rm -rf /opt/deps_ws/build /opt/deps_ws/log /tmp/image_deps.repos

# Bootstrap/dev containers are --rm (ephemeral): known_hosts never persists, so
# every fresh container re-triggers the interactive host-key prompt on the first
# git clone over SSH. accept-new auto-trusts unseen hosts but still rejects a
# host key that changed from one already accepted, unlike StrictHostKeyChecking=no.
# The NVIDIA container toolkit mounts libEGL_nvidia.so but not the libglvnd ICD
# manifest that points at it - CUDA base images ship that file, plain ros:jazzy
# does not. Without it libglvnd sees only 50_mesa.json and every EGL context
# falls back to llvmpipe, which for gz means the gpu_lidar raycasts the scene on
# the CPU. The libraries are already there; this is just the missing pointer.
RUN mkdir -p /usr/share/glvnd/egl_vendor.d \
    && printf '%s\n' \
       '{' \
       '    "file_format_version" : "1.0.0",' \
       '    "ICD" : {' \
       '        "library_path" : "libEGL_nvidia.so.0"' \
       '    }' \
       '}' > /usr/share/glvnd/egl_vendor.d/10_nvidia.json

RUN git config --global core.sshCommand "ssh -o StrictHostKeyChecking=accept-new"

WORKDIR /workspace

RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> /root/.bashrc \
    && echo "source /opt/deps_ws/install/setup.bash" >> /root/.bashrc \
    && echo "[ -f /workspace/gbplanner3_ws/install/setup.bash ] && source /workspace/gbplanner3_ws/install/setup.bash" >> /root/.bashrc

CMD ["bash"]
